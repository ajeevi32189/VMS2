# ─────────────────────────────────────────────────────────────────────────────
#  Analytics Engine — AI Consumer
#  Base: NVIDIA CUDA 13.2 + cuDNN runtime (matches server GPU environment)
#  Python 3.11 installed via apt (deadsnakes PPA)
# ─────────────────────────────────────────────────────────────────────────────
FROM nvcr.io/nvidia/cuda:12.2.0-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# ── System dependencies ───────────────────────────────────────────────────────
# software-properties-common → needed for deadsnakes PPA (Python 3.11)
# libgl1 + libglib2.0-0 → required by OpenCV
# libsm6, libxrender1, libxext6 → required by scikit-image / some cv2 internals
# ffmpeg → required by some YOLO video utilities
# curl → useful for healthchecks
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-distutils \
    gcc \
    g++ \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgl1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

# Make python3.11 the default python/python3
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# ── Python dependencies ───────────────────────────────────────────────────────
# Copy requirements first to leverage Docker layer cache
COPY requirements.txt .
RUN pip install --default-timeout=1000 --no-cache-dir --ignore-installed -r requirements.txt

# ── Application code ──────────────────────────────────────────────────────────
# Copy everything: consumer.py + Detection/ folder + models/ folder (.pt files)
COPY . .

# ── Environment ───────────────────────────────────────────────────────────────
# Prevent Python from buffering stdout/stderr (important for live Docker logs)
ENV PYTHONUNBUFFERED=1
ENV RABBITMQ_HOST=rabbitmq
# ROI API base URL — consumed by Detection/intrusion.py via os.getenv("ROI_API_URL")
# Override at runtime: docker run -e ROI_API_URL=http://your-api-host:8000 ...
ENV ROI_API_URL=http://api:8000
# ── GPU passthrough (required for nvidia-docker / Docker --gpus all) ──────────
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Suppress ONNX Runtime CUDA provider fallback warnings (non-fatal, CPU fallback is fine)
ENV ORT_LOGGING_LEVEL=3

# ── Entrypoint ────────────────────────────────────────────────────────────────
# CONSUMER_GROUP : which all_frames_{group} queue to consume (set in docker-compose)
# Default = 1 ; override per container: CONSUMER_GROUP=2, CONSUMER_GROUP=3 ...
ENV CONSUMER_GROUP=1

CMD ["python", "consumer.py"]